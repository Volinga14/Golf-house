# Copia a .env. No compartas .env ni claves privadas.
# Para Docker + HTTPS: dominio apuntando a la IP de tu servidor.
DOMAIN=golf.tu-dominio.com
PUBLIC_URL=http://localhost:3000
# Docker toma PUBLIC_URL de DOMAIN automáticamente. Sin Docker, usa tu URL HTTPS real.
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
MEDIA_QUOTA_MB=2048
# Si se deja vacío, el servidor genera una clave y la muestra en la consola.
SETUP_TOKEN=
# Opcional: npm install && npm run push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com
