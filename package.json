{
  "name": "clubhouse-golf",
  "version": "3.0.0",
  "private": true,
  "description": "Liga privada de golf, Stableford y club social en directo",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test tests/*.test.mjs",
    "push:keys": "node tools/push-keys.mjs",
    "backup": "node --env-file-if-exists=.env tools/backup.mjs",
    "build:pages": "node tools/build-pages.mjs",
    "build:demo": "node tools/build-demo.mjs"
  },
  "optionalDependencies": {
    "web-push": "3.6.7"
  }
}
